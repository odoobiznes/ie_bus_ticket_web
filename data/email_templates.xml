<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email template for booking notification -->
        <record id="email_template_booking_notification" model="mail.template">
            <field name="name">Bus Booking Notification</field>
            <field name="model_id" ref="model_modern_bus_reservation"/>
            <field name="subject">Nová rezervace jízdenky - {{ object.name }}</field>
            <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ ctx.get('notification_emails', 'maryna@biznesmen.cz, symchera@email.cz') }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                    <h2 style="color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px;">
                        Nová rezervace jízdenky
                    </h2>
                    
                    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 5px; margin: 20px 0;">
                        <h3 style="color: #34495e; margin-top: 0;">Detaily rezervace</h3>
                        
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="padding: 8px; font-weight: bold; width: 40%;">Číslo rezervace:</td>
                                <td style="padding: 8px;">{{ object.name }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Jméno cestujícího:</td>
                                <td style="padding: 8px;">{{ object.passenger_name }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Email:</td>
                                <td style="padding: 8px;">{{ object.passenger_email }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Telefon:</td>
                                <td style="padding: 8px;">{{ object.passenger_phone }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Trasa:</td>
                                <td style="padding: 8px;">
                                    {% if object.route_id %}
                                        {{ object.route_id.bording_from.name if object.route_id.bording_from else '' }} 
                                        → 
                                        {{ object.route_id.to.name if object.route_id.to else '' }}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Datum cesty:</td>
                                <td style="padding: 8px;">
                                    {% if object.route_id and object.route_id.trip_date %}
                                        {{ object.route_id.trip_date.strftime('%d.%m.%Y') }}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Čas odjezdu:</td>
                                <td style="padding: 8px;">
                                    {% if object.route_id and object.route_id.trip_start_date %}
                                        {% set hours = object.route_id.trip_start_date|int %}
                                        {% set minutes = ((object.route_id.trip_start_date - hours) * 60)|int %}
                                        {{ "%02d:%02d"|format(hours, minutes) }}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Sedadla:</td>
                                <td style="padding: 8px;">{{ object.selected_seats or object.seat_number or 'AUTO' }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Nástupní místo:</td>
                                <td style="padding: 8px;">{{ object.boarding_point.name if object.boarding_point else (object.route_id.bording_from.name if object.route_id and object.route_id.bording_from else '') }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Výstupní místo:</td>
                                <td style="padding: 8px;">{{ object.dropping_point.name if object.dropping_point else (object.route_id.to.name if object.route_id and object.route_id.to else '') }}</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Cena:</td>
                                <td style="padding: 8px; font-weight: bold; color: #27ae60;">
                                    {% set price = object.get_correct_price() %}
                                    {{ "%.2f"|format(price) }} {{ object.env.company.currency_id.symbol if object.env.company.currency_id else 'CZK' }}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Status:</td>
                                <td style="padding: 8px;">
                                    {% if object.status == 'reserved' %}
                                        <span style="color: #f39c12;">Rezervováno</span>
                                    {% elif object.status == 'paid' %}
                                        <span style="color: #27ae60;">Zaplaceno</span>
                                    {% elif object.status == 'cancelled' %}
                                        <span style="color: #e74c3c;">Zrušeno</span>
                                    {% else %}
                                        {{ object.status }}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; font-weight: bold;">Datum rezervace:</td>
                                <td style="padding: 8px;">{{ object.reservation_date.strftime('%d.%m.%Y %H:%M') if object.reservation_date else '' }}</td>
                            </tr>
                        </table>
                    </div>
                    
                    <div style="margin-top: 20px; padding: 15px; background-color: #ecf0f1; border-radius: 5px; font-size: 12px; color: #7f8c8d;">
                        <p style="margin: 0;">Tento email byl automaticky vygenerován systémem rezervace jízdenek.</p>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>

